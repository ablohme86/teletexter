#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/ioctl.h>
#include <linux/i2c-dev.h>
#include "lcdlib.h"

int lcd_fd;

void write_byte(int byte) 
{
    unsigned char buffer[2];
    buffer[0] = byte;
    buffer[1] = byte | ENABLE_BIT;
    write(lcd_fd, buffer, 2);
    buffer[1] = byte & ~ENABLE_BIT;
    write(lcd_fd, buffer, 2);
    usleep(500);
}

void lcd_write(int byte, int mode) 
{
    unsigned char backlight_mode = LCD_BACKLIGHT;

    if (mode == 0) 
    {
        backlight_mode = LCD_NOBACKLIGHT;
    }

    write_byte(mode | (byte & 0xF0) | backlight_mode);
    write_byte(mode | ((byte << 4) & 0xF0) | backlight_mode);
}

void lcd_text(const char *text, int line) 
{
    static const int lines[] = {0x80, 0xC0, 0x94, 0xD4};

    if (line < 1 || line > LCD_ROWS) 
    {
        return;
    }

    lcd_write(lines[line - 1], 0);
    for (int i = 0; i < LCD_WIDTH; ++i) 
    {
        if (*text) 
        {
            lcd_write(*text++, 1);
        } 
        else 
        {
            lcd_write(' ', 1);
        }
    }
}

void lcd_backlight(int turn_on) 
{
    lcd_write(turn_on ? 0 : LCD_NOBACKLIGHT, 0);
}

void lcd_clear() 
{
    lcd_write(LCD_CLEAR_DISPLAY, 0);
}
void clear_display()
{
    write_byte(0x33);
    write_byte(0x32);
    write_byte(0x06);
    write_byte(0x0C);
    write_byte(0x28);
    lcd_clear();
}
void send_msg(char* text, int line)
{
    write_byte(0x33);
    write_byte(0x32);
    write_byte(0x06);
    write_byte(0x0C);
    write_byte(0x28);
	lcd_text(text,line);
}

int init_display() 
{
    lcd_fd = open("/dev/i2c-1", O_RDWR);
    if (lcd_fd < 0) {
        perror("Failed to open the LCD I2C bus");
        return -1;
    }

    if (ioctl(lcd_fd, I2C_SLAVE, LCD_I2C_ADDR) < 0) {
        perror("Failed to acquire bus access and/or talk to slave");
        return -1;
    }
    return 0;
}
void close_display()
{
	close(lcd_fd)
}

